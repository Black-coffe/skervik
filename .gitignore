# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/

# VULYK runtime artifacts that should stay local
memory/snapshots/*
!memory/snapshots/.gitkeep
memory/map/.stale

# Local-only Claude Code settings (commit settings.json, not local overrides)
.claude/settings.local.json
CLAUDE.local.md

# Node / TypeScript (for the upcoming monorepo — see CLAUDE.md)
node_modules/
dist/
build/
coverage/
*.log
.env
.env.local
.pnpm-store/

# S2.2.5 balance-sim CLI output — generated per-run; the story file carries the reported numbers.
packages/bots/sim-results.json

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
.claude/handoff/
.claude/.vulyk-update-cache
.claude/settings.json.vulyk-bak
.claude/state.json
memory/snapshots/
__pycache__/

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
.vulyk/
docs/specs/*/PAUSE

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
docs/specs/*/DRIVER

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
