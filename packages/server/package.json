    "pg": "^8.22.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/testing": "^0.17.11",
    "@electric-sql/pglite": "^0.5.4",
